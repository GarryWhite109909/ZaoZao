# ===== 实验产物：保留 results.json 与 best/ 元数据，但排除临时调试文件 =====
experiments/**/debug_*.json
experiments/**/*.tmp
experiments/**/_draft*
# 旧版本实验结果备份（含答案泄露/旧模型版本）
experiments/**/results.*-with-*.json
# 训练中间 checkpoint（断点续训用，体积大；保留 best/ 即可复现评估）
experiments/**/outputs/**/checkpoint-*/
# 历史失败/暂缓训练产物归档（体积大，仅本地保留）
experiments/**/outputs/_archive_*/
# 每个 checkpoint 自动生成的 README（best/ 的已保留）
experiments/**/outputs/**/README.md
!experiments/**/outputs/**/best/README.md
# tokenizer 是 base 模型权重的组成部分，体积大且可从 HuggingFace 重新获取
experiments/**/outputs/**/tokenizer.json
# HF datasets / transformers 运行时缓存
**/.cache/
# 依赖安装的 wheel 缓存（如 500MB+ 的 llama-cpp-python CUDA wheel，落项目 cache/wheels）
cache/
# TunableOp 离线调优中间产物（保留 tuned.csv 与 untuned0.csv）
experiments/**/configs/tunableop_tuned_partial*.csv
experiments/**/configs/tunableop_record.log
experiments/**/configs/tunableop_tune.log

