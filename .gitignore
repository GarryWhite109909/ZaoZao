# Ollama 本地模型缓存
~/.ollama/
# 模型发布产物（merged HF / GGUF / Modelfile，由 release_model.sh 生成）
outputs/

# 项目内 LoRA adapter：允许用户将 adapter 放到 models/adapter/ 并推送远程
# 注意：adapter_model.safetensors 可能很大，建议配合 git-lfs 使用
!models/
!models/**/
!models/**/adapter_model.safetensors
!models/**/adapter_model.bin
!models/**/adapter_model.gguf
!models/**/adapter_config.json
!models/**/README.md
# 本地基座模型权重（models/transformers/，大文件 + 版权，绝不入库）
models/transformers/
# Ollama 模型存储（models/ollama/，GGUF/分片大文件，绝不入库）
models/ollama/
# 信号注册表运行时产物（第 2.5 代置信回填持久化，扫描自动重建，不入库）
models/signal_registry.json
# 后端扫描历史统计（/api/stats 数据源，扫描可重建，不入库）
data/scan_stats.json
data/scan_stats.json.tmp

# RAG 向量数据库（本地持久化，体积大且无需入库）
