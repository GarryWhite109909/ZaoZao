      "unanimous": true
    },
    {
      "file": "app/data/allocations-dao.js",
      "feature": "llm_only:CWE-943 Improper Neutralization of Special Elements in Data Query Logic",
      "evidence": "line 53:将未过滤的 threshold 直接拼接进 $where 字符串 → 攻击者可通过注入 '$ne' 等操作符绕过查询逻辑 → 导致 NoSQL 注入",
      "unanimous": true
    },
