<!--
  凿凿 IntelliJ 插件描述文件。
  注册 VulnScannerAction 动作，并声明通知组。
  构建需 IntelliJ Platform SDK（响应解析使用平台捆绑的 Gson）。
-->
<idea-plugin>
    <id>com.graduation.vulnscanner</id>
    <name>凿凿</name>
    <vendor email="graduation@example.com" url="https://github.com/graduation/vulnscanner">毕业设计</vendor>

    <description><![CDATA[
        凿凿 —— 基于大语言模型的代码安全审计 IntelliJ 插件。<br/>
        选中编辑器中的代码，右键调用后端 /api/analyze 接口进行两阶段漏洞扫描<br/>
        （Stage 1 工具召回 + Stage 2 LLM 裁决 + 信任层），结果以通知展示结论与<br/>
        信任层摘要（置信度/共形预测/反事实/证据门）。需先启动后端服务<br/>
        （默认 http://localhost:8765）。
    ]]></description>

    <!-- 兼容的 IntelliJ Platform 版本范围 -->
    <idea-version since-build="221" until-build="262.*"/>

    <!-- 依赖：核心平台 API（通知、动作、编辑器） -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 注册通知组，供 VulnScannerAction 弹出结果通知（与代码中组名保持一致） -->
        <notificationGroup id="凿凿" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <actions>
        <!-- 注册扫描动作：编辑器右键菜单 + 工具菜单 -->
        <action id="VulnScanner.ScanSelection"
                class="com.graduation.vulnscanner.VulnScannerAction"
                icon="/icons/vuln-scanner-light.png"
                text="凿凿 漏洞扫描(_S)"
                description="将选中代码发送到后端进行两阶段漏洞分析（含信任层）">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <!-- Ctrl+Shift+V 与 IDEA 默认"从历史粘贴"冲突，改用 Ctrl+Alt+Shift+V -->
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift V"/>
        </action>
    </actions>
</idea-plugin>
