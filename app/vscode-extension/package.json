{
  "name": "vuln-scanner",
  "displayName": "凿凿 · AI 代码漏洞分析",
  "description": "凿凿（ZaoZao）—— 基于 LLM 两阶段架构的代码安全审计：右键分析文件、批量扫描工作区、信任层明细与实时诊断标记",
  "version": "1.3.0",
  "publisher": "graduation-project",
  "repository": { "type": "git", "url": "https://github.com/GarryWhite109909/Graduation-Project.git" },
  "icon": "assets/icon-light.png",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Linters", "Other"],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:java",
    "onLanguage:php",
    "onLanguage:go",
    "onLanguage:html"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vulnScanner.analyzeFile",
        "title": "凿凿: 分析当前文件",
        "icon": "$(shield)"
      },
      {
        "command": "vulnScanner.scanWorkspace",
        "title": "凿凿: 批量扫描工作区",
        "icon": "$(folder-library)"
      },
      {
        "command": "vulnScanner.scanFolder",
        "title": "凿凿: 扫描此文件夹",
        "icon": "$(folder)"
      },
      {
        "command": "vulnScanner.clearDiagnostics",
        "title": "凿凿: 清除诊断标记",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vulnScanner.analyzeFile",
          "when": "resourceLangId == python || resourceLangId == javascript || resourceLangId == typescript || resourceLangId == javascriptreact || resourceLangId == typescriptreact || resourceLangId == java || resourceLangId == php || resourceLangId == go || resourceLangId == html || resourceLangId == vue",
          "group": "2_vulnScanner@1"
        }
      ],
      "editor/title": [
        {
          "command": "vulnScanner.analyzeFile",
          "when": "editorIsOpen",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "vulnScanner.analyzeFile",
          "when": "!explorerResourceIsFolder",
          "group": "2_vulnScanner@1"
        },
        {
          "command": "vulnScanner.scanFolder",
          "when": "explorerResourceIsFolder",
          "group": "2_vulnScanner@2"
        }
      ],
      "commandPalette": [
        { "command": "vulnScanner.analyzeFile" },
        { "command": "vulnScanner.scanWorkspace" },
        { "command": "vulnScanner.scanFolder" },
        { "command": "vulnScanner.clearDiagnostics" }
      ]
    },
    "configuration": {
      "title": "凿凿",
      "properties": {
        "vulnScanner.backendUrl": {
          "type": "string",
          "default": "http://localhost:8765",
          "description": "后端服务地址"
        },
        "vulnScanner.useRag": {
          "type": "boolean",
          "default": false,
          "description": "是否启用 RAG 知识库增强（较慢但更准）"
        },
        "vulnScanner.markDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "发现漏洞时在编辑器中标记诊断波浪线（两阶段响应按每个确认的裁决精确定位，支持多处标记）"
        },
        "vulnScanner.autoScanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "保存文件时自动扫描（实验性，1.5s 防抖合并连续保存）"
        },
        "vulnScanner.workspaceExclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/node_modules/**", "**/.git/**", "**/vendor/**", "**/__pycache__/**", "**/dist/**", "**/build/**"],
          "description": "批量扫描工作区时排除的 glob 模式（清空时自动回退为默认值，防止扫入依赖目录）"
        },
        "vulnScanner.workspaceMaxFiles": {
          "type": "number",
          "default": 50,
          "description": "批量扫描工作区时最多扫描的文件数"
        },
        "vulnScanner.requestTimeout": {
          "type": "number",
          "default": 300000,
          "description": "单次请求超时时间（毫秒）"
        }
      }
    }
  }
}
